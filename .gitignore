# Build output
build/
out/
cmake-build-*/
builddir/
_deps/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# Tool and IDE caches
.cache/
.vs/
.idea/
.xmake/
compile_commands.json
CMakeUserPresets.json
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Package managers (the manifests are committed, the installed files are not)
vcpkg_installed/
conan_output/

# Downloaded archives of third-party code (the extracted, pinned sources in third_party/ are committed)
third_party/_downloads/

# Tool output
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
*.coverage
coverage/
callgrind.out.*
perf.data*
flamegraph.svg
crash-*
leak-*
timeout-*
oom-*

# Databases and local data (never commit real personal data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/private/

# Books and other documents (copyright)
books/
*.pdf

# Secrets
.env
.env.*
!.env.example
*.secret

# Local backups of learner data
# learner/.gitignore ignores the learner data on master.
learner-backup-*/
